#!/usr/bin/env python3
"""
pi-usage — token & cost analytics for pi (the coding agent).

Reads the JSONL sessions under ~/.pi/agent/sessions/ and aggregates per
model, provider, project, day and session. No dependencies, no SQLite, no
web UI. Costs come straight from the session logs (pi writes
`usage.cost.total` with each assistant reply).

The output is colored in pi's vesper style (peach/mint/teal) and shows
among others a stacked cost bar (input / output / cache) for today.

Usage:
    pi-usage                # Compact overview (today + 7 days + totals)
    pi-usage today          # Today (with cost bar)
    pi-usage week           # Last 7 days (per day + per model)
    pi-usage stats          # Totals by model, provider, project
    pi-usage sessions       # Per session, sorted by usage
    pi-usage --extended     # also show reasoning / cache tokens
    pi-usage --json         # raw aggregates as JSON
    pi-usage --no-color     # disable ANSI colors (or NO_COLOR)
    pi-usage -w             # Watch: refresh every 5 s (Ctrl+C to stop)
    pi-usage -w -n 10       # Watch with custom interval (e.g. 10 s)
    pi-usage -w today       # Watch works with any view
"""

import argparse
import hashlib
import json
import os
import shutil
import sys
import time
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

SESSIONS_DIR = Path(os.environ.get("PI_SESSIONS_DIR", Path.home() / ".pi" / "agent" / "sessions"))

AGG_KEYS = ["input", "output", "cacheRead", "cacheWrite", "reasoning", "tokens"]
COST_KEYS = ["input", "output", "cacheRead", "cacheWrite", "total"]

# ---- Vesper colors (user's pi theme) ----
PANEL = "#1A1A1A"
SURFACE = "#232323"
SURFACE1 = "#282828"
OVERLAY0 = "#5C5C5C"
TEXT = "#FFFFFF"
SUBTEXT = "#A0A0A0"
ACCENT = "#FFC799"    # peach – input
MINT = "#99FFE4"      # success – output
CACHE = "#7AA2F7"     # blue – cache (clearly distinct)
TEAL = "#66DDCC"      # cR/cW text color
RED = "#FF8080"


def _tty():
    return hasattr(sys.stdout, "isatty") and sys.stdout.isatty()


USE_COLOR = not os.environ.get("NO_COLOR") and _tty()


def _fg(hexs):
    h = hexs.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"38;2;{r};{g};{b}"


def _bg(hexs):
    h = hexs.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"48;2;{r};{g};{b}"


def col(code, s):
    return f"\x1b[{code}m{s}\x1b[0m" if USE_COLOR else str(s)


def ptext(s):   return col(_fg(TEXT), s)
def psub(s):    return col(_fg(SUBTEXT), s)
def pdim(s):    return col(_fg(OVERLAY0), s)
def pacc(s):    return col(_fg(ACCENT), s)
def pmint(s):   return col(_fg(MINT), s)
def pteal(s):   return col(_fg(TEAL), s)
def pred(s):    return col(_fg(RED), s)
def pbold(s):   return col("1", s)
def phead(s):   return pacc(pbold(s))


def make_zero():
    a = dict.fromkeys(AGG_KEYS, 0)
    a["cost"] = dict.fromkeys(COST_KEYS, 0.0)
    a["requests"] = 0
    a["sessions"] = set()
    return a


def merge(target, other):
    for k in AGG_KEYS:
        target[k] += other[k]
    for k in COST_KEYS:
        target["cost"][k] += other["cost"][k]
    target["requests"] += other["requests"]
    target["sessions"] |= other["sessions"]
    return target


def fmt_tokens(n):
    if n >= 1_000_000_000:
        return f"{n / 1e9:.1f}B"
    if n >= 1_000_000:
        return f"{n / 1e6:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}k"
    return str(int(n))


def fmt_cost(c, extended):
    if extended:
        return f"${c:,.4f}"
    if 0 < c < 0.01:
        # round sub-cent amounts up instead of showing $0.00 or $0.0038
        return "$0.01"
    return f"${c:,.2f}"


def term_width():
    try:
        cols = shutil.get_terminal_size().columns
    except Exception:
        cols = 80
    return max(cols, 40)


def cost_parts(a):
    """Cost shares for the bar: (label, cost, color)."""
    c = a["cost"]
    cache = (c.get("cacheRead", 0) or 0) + (c.get("cacheWrite", 0) or 0)
    parts = [
        ("input",  c.get("input", 0) or 0.0, ACCENT),
        ("output", c.get("output", 0) or 0.0, MINT),
        ("cache",  cache, CACHE),
    ]
    parts = [p for p in parts if p[1] > 0]
    # fixed order: input, output, cache (not sorted by cost)
    return parts


def _bar_alloc(parts, total, width):
    """Distributes `width` blocks proportionally over the segments (largest
    remainder). Returns a list of (name, color, count)."""
    if not total or not parts:
        return [(p[0], p[2], 0) for p in parts]
    n = len(parts)
    shares = [p[1] / total * width for p in parts]
    counts = [int(s) for s in shares]
    used = sum(counts)
    rem = max(0, width - used)
    order = sorted(range(n), key=lambda i: shares[i] - counts[i], reverse=True)
    for i in order[:rem]:
        counts[i] += 1
    return [(parts[i][0], parts[i][2], counts[i]) for i in range(n)]


def _bar_line(parts, total, width):
    """One line of solid blocks without gaps. When there really is no cost
    (0), the bar stays transparent (empty cells without background/color)."""
    if not parts or total is None or total <= 0:
        return " " * width
    segs = _bar_alloc(parts, total, width)
    cells = []
    for _name, color, cnt in segs:
        if cnt:
            cells.append(col(_fg(color), "█") * cnt)
    return "".join(cells)


def cost_bar(a, width=None, extended=False, label=None):
    """Segmented bar: how much input / output / cache each contributes."""
    total = a["cost"]["total"]
    parts = cost_parts(a)
    if width is None:
        width = min(term_width() - 12, 34)
        width = max(width, 10)
    if label is None:
        label = "Cost today" if total else "Cost"
    lines = [phead(label)]
    lines.append(" " + _bar_line(parts, total, width) + " ")
    if parts:
        for name, cost, color in parts:
            pct = cost / total * 100
            lines.append("  " + col(_fg(color), "█") + " "
                         + psub(f"{name:<8}") + psub(f"{pct:5.1f}%")
                         + "  " + pacc(pbold(fmt_cost(cost, extended))))
        lines.append("  " + psub(f"{'Total':<9}") + pmint(pbold(fmt_cost(total, extended))))
    else:
        lines.append("  " + pdim("(no costs yet)"))
    return "\n".join(lines)


def section(title):
    return phead(title)


CACHE_VERSION = 2


def _cache_dir():
    """Cache directory for one sessions directory (shards live inside)."""
    base = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "pi-usage"
    key = str(SESSIONS_DIR.resolve())
    return base / ("sessions-" + hashlib.sha256(key.encode("utf-8")).hexdigest()[:16])


def _shard_path(rel_dir):
    """Path of the cache shard for one relative directory."""
    name = "shard-" + hashlib.sha256(rel_dir.encode("utf-8")).hexdigest()[:12] + ".json"
    return _cache_dir() / name


def _parse_file(fp, session_id, project):
    """Parses ONE JSONL session and returns (max_day, parts).

    parts is a list of (dimension, key, agg) tuples across all six aggregate
    dimensions (day / model / day_model / provider / project / session) — the
    same logic scan() used globally before, only pre-accumulated per file so
    the result can be combined arbitrarily via merge() later. Returns None
    when the file is unreadable.

    Record schema (one JSON line per record):
      type=message, message.role=assistant
      message.usage = {input, output, cacheRead, cacheWrite, reasoning?,
                       totalTokens, cost:{input, output, cacheRead, cacheWrite, total}}
      message.model, message.provider
    Date from r["timestamp"] (ISO UTC) or message.timestamp (ms)."""
    try:
        fh = open(fp, encoding="utf-8", errors="replace")
    except OSError:
        return None
    p_day = defaultdict(make_zero)
    p_model = defaultdict(make_zero)
    p_provider = defaultdict(make_zero)
    p_project = defaultdict(make_zero)
    p_session = defaultdict(make_zero)
    p_day_model = defaultdict(lambda: defaultdict(make_zero))  # Tag -> Modell -> Agg
    max_day = None
    with fh:
        for line in fh:
            if '"usage"' not in line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            msg = rec.get("message")
            if not isinstance(msg, dict) or msg.get("role") != "assistant":
                continue
            usage = msg.get("usage")
            if not isinstance(usage, dict):
                continue

            # Zeitstempel
            ts = rec.get("timestamp") or msg.get("timestamp")
            key = "undated"
            if isinstance(ts, str):
                try:
                    day = datetime.fromisoformat(ts.replace("Z", "+00:00")).date()
                    key = day.isoformat()
                except ValueError:
                    pass
            elif isinstance(ts, (int, float)):
                day = datetime.fromtimestamp(ts / 1000, tz=timezone.utc).date()
                key = day.isoformat()
            if key != "undated" and (max_day is None or day > max_day):
                max_day = day

            agg = make_zero()
            cost = usage.get("cost") or {}
            agg["input"] = usage.get("input", 0)
            agg["output"] = usage.get("output", 0)
            agg["cacheRead"] = usage.get("cacheRead", 0)
            agg["cacheWrite"] = usage.get("cacheWrite", 0)
            agg["reasoning"] = usage.get("reasoning", 0)
            agg["tokens"] = usage.get("totalTokens", agg["input"] + agg["output"])
            for k in COST_KEYS:
                agg["cost"][k] = cost.get(k, 0.0) or 0.0
            agg["requests"] = 1
            agg["sessions"].add(session_id)

            model = msg.get("model") or "unknown"
            merge(p_day[key], agg)
            merge(p_model[model], agg)
            if key != "undated":
                merge(p_day_model[key][model], agg)
            merge(p_provider[msg.get("provider") or "unknown"], agg)
            merge(p_project[project], agg)
            merge(p_session[session_id], agg)

    parts = []
    parts += [("day", k, a) for k, a in p_day.items()]
    parts += [("model", k, a) for k, a in p_model.items()]
    parts += [("day_model", "%s\x00%s" % (k, m), a)
              for k, dm in p_day_model.items() for m, a in dm.items()]
    parts += [("provider", k, a) for k, a in p_provider.items()]
    parts += [("project", k, a) for k, a in p_project.items()]
    parts += [("session", k, a) for k, a in p_session.items()]
    return max_day, parts


def _cache_jsonable(entry):
    """Cache entry -> JSON-friendly (sets -> lists, date -> ISO string)."""
    return {
        "sig": entry["sig"],
        "max_day": entry["max_day"].isoformat() if entry["max_day"] else None,
        "parts": [[d, k, {**dict(a), "cost": dict(a["cost"]),
                           "sessions": sorted(a["sessions"])}]
                   for d, k, a in entry["parts"]],
    }


def _cache_pythonic(entry):
    """JSON cache entry -> Python form (lists -> sets, ISO string -> date)."""
    md = entry.get("max_day")
    parts = []
    for dim, key, agg in entry["parts"]:
        a = dict(agg)
        a["cost"] = dict(agg.get("cost") or {})
        a["sessions"] = set(agg.get("sessions") or [])
        parts.append((dim, key, a))
    return {
        "sig": entry["sig"],
        "max_day": datetime.fromisoformat(md).date() if md else None,
        "parts": parts,
    }


def _load_cache():
    """Read all cache shards from disk; {} on error or wrong origin."""
    if os.environ.get("PI_USAGE_NO_CACHE"):
        return {}
    cache = {}
    try:
        for p in _cache_dir().glob("*.json"):
            data = json.loads(p.read_text(encoding="utf-8"))
            if data.get("version") != CACHE_VERSION:
                continue
            rel_dir = data.get("rel_dir", "")
            for fn, e in (data.get("files") or {}).items():
                cache[f"{rel_dir}/{fn}" if rel_dir else fn] = _cache_pythonic(e)
    except (OSError, ValueError):
        return {}
    return cache


def _save_shards(cache, rel_dirs):
    """Write only the cache shards of the changed directories (atomic,
    errors silently dropped). A single project change rewrites just its own
    shard, not the whole history."""
    if os.environ.get("PI_USAGE_NO_CACHE") or not rel_dirs:
        return
    groups = {}
    for rel, e in cache.items():
        rd, _, fn = rel.rpartition("/")
        groups.setdefault(rd, {})[fn] = e
    for rd in sorted(set(rel_dirs)):
        entries = groups.get(rd, {})
        try:
            path = _shard_path(rd)
            if not entries:
                path.unlink(missing_ok=True)  # project vanished -> drop its shard
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            blob = json.dumps({"version": CACHE_VERSION, "rel_dir": rd,
                               "files": {fn: _cache_jsonable(e) for fn, e in entries.items()}})
            tmp = path.with_suffix(".tmp")
            tmp.write_text(blob, encoding="utf-8")
            os.replace(tmp, path)
        except OSError:
            pass  # cache is optional — a blessing, not a curse


def scan(cache=None, persist=True):
    """Aggregate across all JSONL sessions; returns
    (max_day, by_day, by_model, by_provider, by_project, by_session,
    by_day_model).

    Uses a persistent mtime/size cache (~/.cache/pi-usage/): files whose
    (mtime_ns, size) is unchanged are not read and parsed again; their
    pre-aggregated parts are reused directly. The cache is sharded per
    relative directory, so a change rewrites only that project's shard and
    survives multiple processes — `pi-usage-herdr` (a fresh subprocess per
    cycle) benefits too.

    Pass `cache` to reuse an in-memory cache (watch mode) and
    `persist=False` to keep it memory-only: watch frames never re-read or
    rewrite the whole cache for the full history."""
    by_day = defaultdict(make_zero)
    by_model = defaultdict(make_zero)
    by_provider = defaultdict(make_zero)
    by_project = defaultdict(make_zero)   # project = sessions subfolder
    by_session = defaultdict(make_zero)
    by_day_model = defaultdict(lambda: defaultdict(make_zero))  # day -> model -> agg
    cache = _load_cache() if cache is None else cache
    dirty_dirs = set()  # directories whose shard must be rewritten
    seen = set()
    max_day = None

    for dirpath, _, files in os.walk(SESSIONS_DIR):
        if not files:
            continue
        project = Path(dirpath).name
        rel_dir = str(Path(dirpath).relative_to(SESSIONS_DIR))
        rel_dir = "" if rel_dir == "." else rel_dir
        for fn in sorted(files):
            if not fn.endswith(".jsonl"):
                continue
            session_id = fn[:-6]
            fp = Path(dirpath) / fn
            rel = f"{rel_dir}/{fn}" if rel_dir else fn
            try:
                st = fp.stat()
            except OSError:
                continue
            sig = [st.st_mtime_ns, st.st_size]
            entry = cache.get(rel)
            if entry is None or entry["sig"] != sig:
                res = _parse_file(fp, session_id, project)
                if res is None:
                    continue
                fmax, parts = res
                entry = {"sig": sig, "max_day": fmax, "parts": parts}
                cache[rel] = entry
                dirty_dirs.add(rel_dir)
            seen.add(rel)
            for dim, key, agg in entry["parts"]:
                if dim == "day":
                    merge(by_day[key], agg)
                elif dim == "model":
                    merge(by_model[key], agg)
                elif dim == "day_model":
                    d, m = key.split("\x00")
                    merge(by_day_model[d][m], agg)
                elif dim == "provider":
                    merge(by_provider[key], agg)
                elif dim == "project":
                    merge(by_project[key], agg)
                elif dim == "session":
                    merge(by_session[key], agg)
            if entry["max_day"] and (max_day is None or entry["max_day"] > max_day):
                max_day = entry["max_day"]

    # drop cache entries whose files vanished (deleted/renamed)
    for rel in set(cache) - seen:
        rd, _, _ = rel.rpartition("/")
        dirty_dirs.add(rd)
        del cache[rel]

    if persist:
        _save_shards(cache, dirty_dirs)
    return max_day, by_day, by_model, by_provider, by_project, by_session, by_day_model


def last_n_days(n, today):
    if today is None:
        return []
    return [(today - timedelta(days=i)).isoformat() for i in range(n - 1, -1, -1)]


def print_compact(by_day, by_model, today):
    print(col(_bg(SURFACE), " ") + " " + ptext(pbold("pi usage")) + " " + pdim("Token & cost analytics"))
    if today is None:
        print(pred("(no sessions found)"))
        return
    t = by_day.get(today.isoformat())
    if t is None:
        t = make_zero()
    base = "─" * max(term_width() - 14, 2)

    print()
    print(section(f"Today · {pdim(today)}"))
    if t["cost"]["total"]:
        print(cost_bar(t, extended=False, label=None))
    print(f"  {psub(f'{fmt_tokens(t['tokens']):>8}')} {pdim('Tokens')}  "
          f"{psub(f'{str(t['requests']):>6}')} {pdim('Requests')}  "
          f"{pmint(pbold(fmt_cost(t['cost']['total'], False)))}")
    print(pdim("└" + base))

    days = last_n_days(7, today)
    print()
    print(section("Last 7 days"))
    tot = make_zero()
    for d in days:
        a = by_day.get(d, make_zero())
        merge(tot, a)
        dtext = f"{d:>12}"  # pad first, then color (ANSI codes count toward :>12)
        dcol = pacc(pbold(dtext)) if d[:10] == today.isoformat() else psub(dtext)
        mini = _mini_bar(a, width=12)
        # compact mini bar instead of a full box
        print(f"  {dcol}  {mini}  "
              f"{psub(f'{fmt_tokens(a['tokens']):>8}')} {pdim('Tok')}  "
              f"{psub(f'{str(a['requests']):>6}')} {pdim('Req')}  "
              f"{pmint(fmt_cost(a['cost']['total'], False))}")
    print(f"  {pbold(f"{'Total':>12}")}  "
          f"{psub(f'{fmt_tokens(tot['tokens']):>8}')} {pdim('Tok')}  "
          f"{psub(f'{str(tot['requests']):>6}')} {pdim('Req')}  "
          f"{pmint(pbold(fmt_cost(tot['cost']['total'], False)))}")
    print(pdim("└" + base))

    print()
    print(section("By model · Total"))
    for m, a in sorted(by_model.items(), key=lambda kv: -kv[1]["tokens"]):
        print(f"  {pmint(f'{fmt_cost(a['cost']['total'], False):>10}')}  "
              f"{psub(f'{fmt_tokens(a['tokens']):>8}')} {pdim('Tok')}  "
              f"{psub(f'{str(a['requests']):>6}')} {pdim('Req')}  {ptext(m)}")
    print(pdim("└" + base))


def _mini_bar(a, width=12):
    """Plain color bar without a legend (for rows)."""
    total = a["cost"]["total"]
    parts = cost_parts(a)
    return _bar_line(parts, total, width)


def print_today(by_day, today, extended):
    print(col(_bg(SURFACE), " ") + " " + ptext(pbold("pi usage · Today")) + " " + pdim(str(today)))
    if today is None:
        print(pred("(no sessions)"))
        return
    a = by_day.get(today.isoformat(), make_zero())
    print()
    print(phead("Cost breakdown (input / output / cache · by cost)"))
    print(cost_bar(a, extended=extended))
    print()
    _print_row("Total", a, extended, show_sessions=True)
    print(pdim("└" + "─" * max(term_width() - 14, 2)))


def print_week(by_day, by_model, today, extended, by_day_model=None):
    days = last_n_days(7, today)
    print(col(_bg(SURFACE), " ") + " " + ptext(pbold("pi usage · Last 7 days")) + " " + pdim(str(today)))
    for d in days:
        a = by_day.get(d, make_zero())
        print(f"  {psub(f'{d[:10]:>10}')}  {_mini_bar(a, width=14)}  "
              f"{psub(f'{str(a['requests']):>6}')} {pdim('Req')}  "
              f"{pmint(fmt_cost(a['cost']['total'], extended))}")
    print()
    if by_day_model:
        # model breakdown only for the 7-day window
        week_models = defaultdict(make_zero)
        for d in days:
            for m, a in by_day_model.get(d, {}).items():
                merge(week_models[m], a)
        print(section("By model · 7 days"))
        by_model = week_models
    else:
        print(section("By model · Total"))
    for m, a in sorted(by_model.items(), key=lambda kv: -kv[1]["tokens"]):
        _print_row(m, a, extended)
    print(pdim("└" + "─" * max(term_width() - 14, 2)))


def print_stats(by_model, by_provider, by_project, today, extended):
    print(col(_bg(SURFACE), " ") + " " + ptext(pbold("pi usage · Overall"))
          + " " + pdim(f"Projects: {len(by_project)} · today {today}"))
    print()
    print(section("By model"))
    for m, a in sorted(by_model.items(), key=lambda kv: -kv[1]["tokens"]):
        _print_row(m, a, extended, show_sessions=True)
    print()
    print(section("By provider"))
    for p, a in sorted(by_provider.items(), key=lambda kv: -kv[1]["tokens"]):
        _print_row(p, a, extended)
    print()
    print(section("By project · Top 15"))
    for p, a in sorted(by_project.items(), key=lambda kv: -kv[1]["tokens"])[:15]:
        _print_row(p, a, extended, show_sessions=True)
    print(pdim("└" + "─" * max(term_width() - 14, 2)))


def print_sessions(by_session, today, extended, limit=20):
    pname = {}
    for dirpath, _, files in os.walk(SESSIONS_DIR):
        project = Path(dirpath).name
        for fn in files:
            if fn.endswith(".jsonl"):
                pname[fn[:-6]] = project
    print(col(_bg(SURFACE), " ") + " " + ptext(pbold("pi usage · Sessions")) + " " + pdim(f"Top {limit}"))
    for sid, a in sorted(by_session.items(), key=lambda kv: -kv[1]["tokens"])[:limit]:
        print(f"  {psub(f'{fmt_tokens(a['tokens']):>8}')} {pdim('Tok')}  "
              f"{psub(f'{str(a['requests']):>6}')} {pdim('Req')}  "
              f"{pmint(fmt_cost(a['cost']['total'], extended))}  "
              f"{pdim(pname.get(sid, '?'))} :: {ptext(sid[:32])}")
    print(pdim("└" + "─" * max(term_width() - 14, 2)))


def _print_row(label, a, extended, show_sessions=False):
    # truncate + pad first, then color (ANSI codes count toward :<38)
    label_s = label if len(label) <= 38 else label[:37] + "…"
    parts = [f"  {ptext(f'{label_s:<38}')}"]
    parts.append(f"{pmint(f'{fmt_cost(a['cost']['total'], extended):>10}')}")
    parts.append(f"{psub(f'{fmt_tokens(a['tokens']):>8}')} {pdim('Tok')}")
    parts.append(f"{psub(f'{str(a['requests']):>6}')} {pdim('Req')}")
    if extended:
        parts.append(f"{ptext('in')} {pacc(f'{fmt_tokens(a['input']):>7}')}")
        parts.append(f"{ptext('out')} {pmint(f'{fmt_tokens(a['output']):>7}')}")
        parts.append(f"{ptext('cR')} {pteal(f'{fmt_tokens(a['cacheRead']):>7}')}")
        parts.append(f"{ptext('cW')} {pteal(f'{fmt_tokens(a['cacheWrite']):>7}')}")
        if a["reasoning"]:
            parts.append(f"{ptext('reas')} {psub(f'{fmt_tokens(a['reasoning']):>7}')}")
    if show_sessions and len(a["sessions"]) > 1:
        parts.append(pdim(f"({len(a['sessions'])} sessions)"))
    print(" ".join(parts))


def to_json(by_model, by_provider, by_project, by_session, today):
    def ser(d):
        return {k: {**{kk: vv for kk, vv in v.items() if kk != "sessions"},
                    **{"cost": v["cost"], "sessions": sorted(v["sessions"]) if isinstance(v["sessions"], set) else v["sessions"]}}
                for k, v in d.items()}
    out = {"today": today.isoformat() if today else None,
           "by_model": ser(by_model), "by_provider": ser(by_provider),
           "by_project": ser(by_project), "by_session": ser(by_session)}
    print(json.dumps(out, indent=2))


def run(args):
    """Read sessions and print the chosen view once."""
    watch = args.watch
    res = scan(cache=getattr(args, "_cache", None), persist=not watch)
    max_day, by_day, by_model, by_provider, by_project, by_session, by_day_model = res
    today = max_day or datetime.now(timezone.utc).date()
    by_day = {k: v for k, v in by_day.items() if k in last_n_days(60, today)}

    if args.json:
        to_json(by_model, by_provider, by_project, by_session, today)
        return

    if args.cmd == "overview":
        print_compact(by_day, by_model, today)
    elif args.cmd == "today":
        print_today(by_day, today, args.extended)
    elif args.cmd == "week":
        print_week(by_day, by_model, today, args.extended, by_day_model)
    elif args.cmd == "stats":
        print_stats(by_model, by_provider, by_project, today, args.extended)
    elif args.cmd == "sessions":
        print_sessions(by_session, today, args.extended)


def _render_to_string(args):
    """Run run(args) once and return the output as a string, without writing
    it directly to stdout."""
    import io
    buf = io.StringIO()
    old = sys.stdout
    sys.stdout = buf
    try:
        run(args)
    finally:
        sys.stdout = old
    return buf.getvalue()


def _redraw(text):
    """Render a frame without flicker: move the cursor to the start, overwrite
    each line (erase-to-EOL removes leftovers of longer previous lines), and
    clear everything below (including wrapped leftovers).

    The whole screen is never cleared — deliberately no \x1b[2J, so the user
    doesn't see a clear/blink effect."""
    lines = text.rstrip("\n").split("\n")
    bits = ["\x1b[H"]  # Cursor nach Hause, ohne zu leeren
    for i, line in enumerate(lines):
        if i:
            bits.append("\n")
        bits.append(line)
        bits.append("\x1b[K")  # clear rest of the line (old, longer cells)
    bits.append("\x1b[J")      # clear everything below (leftovers from previous frame)
    return "".join(bits)


def _enter_alt():
    """Alternate screen (like top/btop): put the content into a separate
    terminal buffer and hide the cursor. On exit the previous terminal
    content is restored untouched."""
    sys.stdout.write("\x1b[?1049h\x1b[?25l")
    sys.stdout.flush()


def _leave_alt():
    sys.stdout.write("\x1b[?25h\x1b[?1049l")
    sys.stdout.flush()


def watch_loop(args):
    tty = sys.stdout.isatty()
    if tty:
        _enter_alt()
    try:
        while True:
            if tty:
                text = _render_to_string(args)
                sys.stdout.write(_redraw(text))
                sys.stdout.flush()
            else:
                print()  # Trennzeile bei Pipe/Umleitung
                run(args)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        if tty:
            _leave_alt()
        sys.exit(0)


def main():
    global USE_COLOR
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[1] if __doc__ else None)
    ap.add_argument("cmd", nargs="?", default="overview", choices=["overview", "today", "week", "stats", "sessions"])
    ap.add_argument("-e", "--extended", action="store_true", help="show input/output/cache tokens per row")
    ap.add_argument("-j", "--json", action="store_true", help="output raw data as JSON")
    ap.add_argument("-s", "--sessions-dir", default=None, help="use a different sessions directory")
    ap.add_argument("-w", "--watch", action="store_true",
                    help="watch mode: re-render without visible clear (Ctrl+C to stop)")
    ap.add_argument("-n", "--interval", type=float, default=5.0,
                    help="update interval in seconds (only with -w, default: 5)")
    ap.add_argument("--no-color", action="store_true", help="disable ANSI colors (NO_COLOR is honored too)")
    ap.add_argument("--no-cache", action="store_true",
                    help="fully re-parse sessions every run (ignore the scan cache)")
    args = ap.parse_args()

    if args.no_color:
        USE_COLOR = False
    if args.no_cache:
        os.environ["PI_USAGE_NO_CACHE"] = "1"

    global SESSIONS_DIR
    if args.sessions_dir:
        SESSIONS_DIR = Path(args.sessions_dir)
    if not SESSIONS_DIR.is_dir():
        print(f"Sessions directory not found: {SESSIONS_DIR}", file=sys.stderr)
        sys.exit(1)

    if args.watch:
        if args.interval <= 0:
            print("interval must be greater than 0", file=sys.stderr)
            sys.exit(1)
        # one in-memory cache for the whole watch session: frames update it
        # in place and never touch the disk cache (no full re-read/rewrite
        # of the whole history every `-n` seconds).
        args._cache = _load_cache()
        watch_loop(args)
    else:
        run(args)


if __name__ == "__main__":
    main()
